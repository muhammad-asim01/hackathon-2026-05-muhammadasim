# ─────────────────────────────────────────────────────────────────────────────
# SiftAi Frontend — Environment Variables
# Copy to .env.local and fill in real values. Never commit .env.local.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── NextAuth ──────────────────────────────────────────────────────────────────
# Must match NEXTAUTH_SECRET in backend .env
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_with_32_plus_char_random_string

# ── Google OAuth (for NextAuth login) ─────────────────────────────────────────
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=123456789-abc.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
