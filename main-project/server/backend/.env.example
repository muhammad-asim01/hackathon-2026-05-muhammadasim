# ─────────────────────────────────────────────────────────────────────────────
# Sift.ai Backend — Environment Variables
# Copy to .env and fill in real values. Never commit .env.
#
# Deployed at: https://hackathon-2026-05-muhammadasim-production.up.railway.app
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
# Railway injects PORT automatically — no need to set in production
NODE_ENV=development
# Production: NODE_ENV=production (set in Railway service variables)

# ── Database (Neon PostgreSQL) ────────────────────────────────────────────────
# https://console.neon.tech → your project → Connection string
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/dbname?sslmode=require

# ── Auth — shared secret with frontend NextAuth ───────────────────────────────
# Must match NEXTAUTH_SECRET / AUTH_SECRET in frontend .env.local exactly
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=replace_with_32_plus_char_random_string

# ── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
# Production: https://saftai.vercel.app

# ── Python Scraper Sidecar ────────────────────────────────────────────────────
# Internal URL of the FastAPI scraper (never exposed to the internet)
PYTHON_SCRAPER_URL=http://localhost:8001
# Production: set to Railway internal URL of the python-scraper service

# ── Anthropic Claude ──────────────────────────────────────────────────────────
# https://console.anthropic.com/settings/keys
# Leave as placeholder to use MockLLMAdapter in dev
ANTHROPIC_API_KEY=sk-ant-api03-...

# Set MOCK_LLM=true to force MockLLMAdapter regardless of API key
MOCK_LLM=false

# ── Google PageSpeed Insights ─────────────────────────────────────────────────
# https://developers.google.com/speed/docs/insights/v5/get-started
GOOGLE_PAGESPEED_API_KEY=AIzaSy...

# ── Gmail OAuth 2.0 ───────────────────────────────────────────────────────────
# OAuth 2.0 credentials from Google Cloud Console
# Scopes needed: https://www.googleapis.com/auth/gmail.send
GMAIL_CLIENT_ID=123456789-abc.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=GOCSPX-...
GMAIL_REDIRECT_URI=http://localhost:3001/auth/google/callback
GMAIL_REFRESH_TOKEN=1//...
GMAIL_SENDER_EMAIL=your@gmail.com

# ── Google Sheets (Tracker Agent) ────────────────────────────────────────────
# Service account with Sheets API enabled
# Share the target spreadsheet with the service account email
GOOGLE_SHEETS_SPREADSHEET_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms
GOOGLE_SERVICE_ACCOUNT_EMAIL=sift-ai@your-project.iam.gserviceaccount.com
# Keep the quotes and \n line breaks exactly as shown
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"
