# Python Scraper Sidecar — copy to .env and fill in values
# This service runs on localhost:8001 and is called by the Node.js backend only.

HOST=0.0.0.0
PORT=8001

# Copy from the Node.js backend .env — both services need this key
GOOGLE_PAGESPEED_API_KEY=

# Max simultaneous Playwright browser contexts (matches Node.js BATCH_SIZE=3)
MAX_CONCURRENT_CRAWLS=3
