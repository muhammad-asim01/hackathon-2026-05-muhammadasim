# ─────────────────────────────────────────────────────────────────────────────
# Sift.ai Python Scraper Sidecar — Environment Variables
# Copy to .env and fill in real values. Never commit .env.
#
# This service is an internal FastAPI sidecar on port 8001.
# It is called by the Node.js backend only — never exposed to the internet.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8001
# Railway injects PORT automatically — no need to set in production
HOST=0.0.0.0

# ── Google PageSpeed Insights ─────────────────────────────────────────────────
# https://developers.google.com/speed/docs/insights/v5/get-started
# Must match GOOGLE_PAGESPEED_API_KEY in backend .env
GOOGLE_PAGESPEED_API_KEY=AIzaSy...

# ── Concurrency ───────────────────────────────────────────────────────────────
# Max simultaneous Playwright crawls (higher = more RAM usage)
MAX_CONCURRENT_CRAWLS=3
